# Copy to .env and edit. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: require "X-API-Key: <value>" on every request (empty = open API)
RAG_API_KEY=

# Optional: enables LLM answers. Leave empty for extractive (no-LLM) answers.
ANTHROPIC_API_KEY=
RAG_LLM_MODEL=claude-sonnet-5-5

# hashing (default, offline) | sentence-transformers | st:<model name>
RAG_EMBEDDER=hashing
